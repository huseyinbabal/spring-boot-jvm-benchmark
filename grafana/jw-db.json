    {
     "refId": "A",
     "expr": "(1 - avg(rate(node_cpu_seconds_total{job=\"db-node\",mode=\"idle\"}[5s]))) * 100 * on() group_left(jvm) jw_phase{jvm!=\"none\"}",
     "legendFormat": "{{jvm}}"
    }
   ],
