{
 "uid": "jw-app",
 "title": "JVM test: app",
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "1s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "1s",
   "5s"
  ]
 },
 "panels": [
  {
   "type": "stat",
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#E6E6E6"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^temurin( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF8A4C"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^corretto( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FFD43B"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^semeru( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4DABF7"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^zulu( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#63E6BE"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^graalvm( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#E599F7"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* (p95|heap|pending|busy)$"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          8
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   },
   "id": 1,
   "title": "requests / s",
   "targets": [
    {
     "refId": "A",
     "expr": "(sum by (jvm) (rate(k6_http_reqs_total[5s]))) and on(jvm) jw_phase{jvm!=\"none\"}",
     "legendFormat": "{{jvm}}"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "stat",
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "min": 0,
     "decimals": 1,
